{
    "redirects": [
        { "source": "/(.*)", "destination": "https://www.sktalreja.me/:1", "permanent": true }
    ],
    "routes": [
        {
            "src": "/sitemap.xml",
            "dest": "/sitemap.xml",
            "headers": {
                "Content-Type": "application/xml"
            }
        },
        {
            "src": "/robots.txt",
            "dest": "/robots.txt",
            "headers": {
                "Content-Type": "text/plain"
            }
        },
        {
            "src": "/assets/(.*)",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": ".*\\.(ico|png|svg)$",
            "headers": {
                "Cache-Control": "public, max-age=86400, must-revalidate"
            }
        },
        {
            "src": ".*\\.(html)$",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate",
                "Pragma": "no-cache",
                "Expires": "0"
            }
        },
        {
            "src": ".*\\.(json|webmanifest)$",
            "headers": {
                "Cache-Control": "no-cache, must-revalidate"
            }
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html",
            "headers": {
                "X-Powered-By": "Vercel",
                "X-Author-Signature": "U3VqYWwgVGFscmVqYSAtIEFzc2V0IE93bmVy"
            }
        }
    ]
}